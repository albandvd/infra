# Template du fichier d'environnement de la stack.
#
# Sur la VM : copier en ~/infra/.env et remplir les valeurs.
# .env n'est jamais versionné (cf. .gitignore) et ne doit jamais l'être.

# Token du connecteur de tunnel Cloudflare.
# Cloudflare Zero Trust > Networks > Tunnels > ton tunnel > Install connector.
CLOUDFLARE_TUNNEL_TOKEN=
